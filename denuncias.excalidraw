   "text": "SELECT denuncias.*, usuarios.nome AS denunciante\nFROM denuncias\nJOIN usuarios ON usuarios.id = denuncias.usuario_id",
   "originalText": "SELECT denuncias.*, usuarios.nome AS denunciante\nFROM denuncias\nJOIN usuarios ON usuarios.id = denuncias.usuario_id",
