{
  "info": {
    "name": "EcoDescarte - Cadastro e Login",
    "description": "Rotas da API do projeto. Rode `python app.py` antes. O Postman guarda o cookie de sessão sozinho: depois do Login, a rota 'Quem está logado' funciona.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    }
  ],
  "item": [
    {
      "name": "1. Cadastro",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana\",\n  \"email\": \"ana@email.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/api/cadastro",
        "description": "Cria um usuário. Respostas: 201 criado, 400 dados inválidos (senha < 6 caracteres), 409 e-mail já cadastrado."
      }
    },
    {
      "name": "2. Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ana@email.com\",\n  \"senha\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/api/login",
        "description": "Faz login e devolve um cookie de sessão. Respostas: 200 ok, 401 e-mail ou senha incorretos."
      }
    },
    {
      "name": "3. Quem está logado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/eu",
        "description": "Retorna os dados do usuário logado. Respostas: 200 ok, 401 não está logado."
      }
    },
    {
      "name": "Usuários (admin)",
      "description": "O sistema cria um admin inicial ao iniciar: admin@ecodescarte.com / admin123. Faça login com ele para usar estas rotas.",
      "item": [
        {
          "name": "Login como admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ecodescarte.com\",\n  \"senha\": \"admin123\"\n}"
            },
            "description": "Login com o admin criado automaticamente."
          }
        },
        {
          "name": "Listar usuários",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/usuarios",
            "description": "Só admin. Use para descobrir o id de quem você quer promover. Respostas: 200, 401 não logado, 403 não é admin."
          }
        },
        {
          "name": "Mudar perfil de usuário",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/usuarios/2",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfil\": \"admin\"\n}"
            },
            "description": "Só admin. Troque o 2 pelo id do usuário. 'perfil': 'admin' ou 'usuario'. Respostas: 200, 400 perfil inválido ou tentando mudar o próprio, 401, 403, 404 não existe."
          }
        }
      ]
    },
    {
      "name": "Denúncias",
      "description": "Faça o Login antes. Para testar como admin, use a pasta 'Usuários (admin)': o admin inicial é admin@ecodescarte.com / admin123.",
      "item": [
        {
          "name": "Registrar denúncia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/denuncias",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"descricao\": \"Entulho jogado no terreno baldio\",\n  \"latitude\": -10.1753,\n  \"longitude\": -48.8823\n}"
            },
            "description": "Qualquer usuário logado. Respostas: 201 criada, 400 descrição vazia ou localização inválida, 401 não logado."
          }
        },
        {
          "name": "Listar denúncias",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/denuncias?status=aberta",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "denuncias"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "aberta",
                  "description": "Opcional: aberta, em_andamento ou resolvida",
                  "disabled": true
                }
              ]
            },
            "description": "Usuário comum vê só as próprias denúncias; admin vê todas. Ative o filtro 'status' na aba Params."
          }
        },
        {
          "name": "Detalhar denúncia",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/denuncias/1",
            "description": "Acompanhar status. Respostas: 200 ok, 404 não existe ou é de outra pessoa."
          }
        },
        {
          "name": "Responder denúncia (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/denuncias/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"em_andamento\",\n  \"resposta\": \"Equipe da prefeitura a caminho.\"\n}"
            },
            "description": "Só admin. Respostas: 200 ok, 400 status inválido, 401 não logado, 403 não é admin, 404 não existe."
          }
        },
        {
          "name": "Resumo por status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/denuncias/resumo",
            "description": "Público. Quantas denúncias em cada status (base para relatórios e contadores)."
          }
        }
      ]
    },
    {
      "name": "4. Logout",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/logout",
        "description": "Apaga a sessão. Depois disso, 'Quem está logado' volta a dar 401."
      }
    }
  ]
}